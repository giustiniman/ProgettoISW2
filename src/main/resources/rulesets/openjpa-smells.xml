<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="OpenJPA smells"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Design and best-practice rules used for NSmells.</description>

    <rule ref="category/java/design.xml"/>

    <rule ref="category/java/bestpractices.xml">
        <exclude name="UseEnumCollections"/>
    </rule>

    <rule name="UseEnumCollections"
          language="java"
          since="7.3.0"
          message="This collection could be an {0}"
          class="it.uniroma2.isw2.openjpa.smell.rule.SafeUseEnumCollectionsRule"
          externalInfoUrl="https://docs.pmd-code.org/pmd-doc-7.7.0/pmd_rules_java_bestpractices.html#useenumcollections">
        <description>
            Use EnumSet or EnumMap instead of HashSet and HashMap when the key type is an enum.
        </description>
        <priority>3</priority>
    </rule>
</ruleset>
